#!/data/data/com.termux/files/usr/bin/bash

# Pastikan nullglob aktif agar pemrosesan file lebih aman
shopt -s nullglob

# Konfigurasi Folder
TMP="$HOME/tmp"
mkdir -p "$TMP"
mkdir -p /sdcard/boot

# Default Settings
WIDTH=1080
HEIGHT=1080
FPS=30
BG="black"
INPUT=""

# --- FUNGSI HEADER STATIS ---
# Menampilkan informasi di bagian atas layar, di luar kotak fzf
print_status() {
    clear
    echo -e "\e[1;36m======================================"
    echo -e "         MENG BOOTANIMATION"
    echo -e "======================================\e[0m"
    echo -e " \e[1mFile\e[0m      : \e[33m${INPUT:-Belum dipilih}\e[0m"
    echo -e " \e[1mResolution\e[0m: \e[32m${WIDTH}x${HEIGHT}\e[0m"
    echo -e " \e[1mFrame Rate\e[0m: \e[32m${FPS} fps\e[0m"
    echo -e " \e[1mBackground\e[0m: \e[32m$BG\e[0m"
    echo -e "\e[1;36m======================================\e[0m"
    echo ""
}

# --- FUNGSI NAVIGASI FILE ---
choose_file() {
    DIR="/sdcard/boot"
    while true; do
        print_status
        # List file dengan warna dan folder di atas
        list=$(ls -1pA --group-directories-first --color=always "$DIR" 2>/dev/null)
        
        choice=$(printf "..\n%s\n" "$list" | fzf --height 15 --reverse --border --ansi --prompt="📁 Pilih File > ")

        [ -z "$choice" ] && return
        
        # Bersihkan kode warna ANSI dari pilihan agar path valid
        clean_choice=$(echo "$choice" | sed $'s/\e\[[0-9;?]*[hlmGK]//g')

        if [ "$clean_choice" = ".." ]; then
            DIR=$(dirname "$DIR")
            [ "$DIR" = "/" ] && DIR="/"
            continue
        fi

        target_path="${DIR}/${clean_choice%/}"
        
        if [ -d "$target_path" ]; then
            DIR="$target_path"
            continue
        fi

        case "$clean_choice" in
            *.gif|*.mp4|*.webm)
                INPUT="$target_path"
                return
                ;;
            *)
                echo -e "\e[31mBukan file video/gif yang didukung!\e[0m"
                sleep 1
                ;;
        esac
    done
}

# --- MENU RESOLUSI LENGKAP ---
set_resolution() {
    print_status
    options=(
        "--- LOW RESOLUTION (Jadul/Entry Level) ---"
        "1. QVGA      | 240x320"
        "2. HVGA      | 320x480"
        "3. nHD       | 360x640"
        "4. WVGA      | 480x800"
        "--- MEDIUM RESOLUTION (HD Series) ---"
        "5. qHD       | 540x960"
        "6. HD        | 720x1280"
        "7. HD+       | 720x1600 (20:9)"
        "--- HIGH RESOLUTION (FHD/Modern) ---"
        "8. FHD       | 1080x1920 (16:9)"
        "9. FHD+      | 1080x2340 (19.5:9)"
        "10. FHD+ Max | 1080x2400 (20:9)"
        "--- ULTRA RESOLUTION (2K/Tablet) ---"
        "11. 2K/QHD   | 1440x2560"
        "12. WQHD+    | 1440x3120"
        "13. Square   | 1024x1024 (Universal)"
        "----------------------------------------"
        "14. Custom   | Input Manual"
    )

    choice=$(printf "%s\n" "${options[@]}" | fzf --height 20 --reverse --border --prompt="Pilih Target Layar > ")
    
    case "$choice" in
        "1."*)  WIDTH=240;  HEIGHT=320 ;;
        "2."*)  WIDTH=320;  HEIGHT=480 ;;
        "3."*)  WIDTH=360;  HEIGHT=640 ;;
        "4."*)  WIDTH=480;  HEIGHT=800 ;;
        "5."*)  WIDTH=540;  HEIGHT=960 ;;
        "6."*)  WIDTH=720;  HEIGHT=1280 ;;
        "7."*)  WIDTH=720;  HEIGHT=1600 ;;
        "8."*)  WIDTH=1080; HEIGHT=1920 ;;
        "9."*)  WIDTH=1080; HEIGHT=2340 ;;
        "10."*) WIDTH=1080; HEIGHT=2400 ;;
        "11."*) WIDTH=1440; HEIGHT=2560 ;;
        "12."*) WIDTH=1440; HEIGHT=3120 ;;
        "13."*) WIDTH=1024; HEIGHT=1024 ;;
        "14."*) 
            echo ""
            read -p "Masukkan Lebar (Width) : " WIDTH
            read -p "Masukkan Tinggi (Height): " HEIGHT 
            ;;
    esac
}


# --- MENU FPS ---
set_fps() {
    print_status
    options=("15" "24" "30" "60" "90" "Custom")
    choice=$(printf "%s\n" "${options[@]}" | fzf --height 12 --reverse --border --prompt="Pilih FPS > ")

    if [[ "$choice" == "Custom" ]]; then
        echo ""
        read -p "Masukkan angka FPS: " FPS
    elif [ -n "$choice" ]; then
        FPS=$choice
    fi
}

# --- MENU WARNA BACKGROUND ---
set_background() {
    print_status
    options=("Black" "White" "Grey (#222222)" "Dark Red (#4d0000)" "Dark Blue (#00004d)" "Custom HEX")
    choice=$(printf "%s\n" "${options[@]}" | fzf --height 12 --reverse --border --prompt="Pilih Warna BG > ")

    case "$choice" in
        "Black") BG="black" ;;
        "White") BG="white" ;;
        "Grey"*) BG="#222222" ;;
        "Dark Red"*) BG="#4d0000" ;;
        "Dark Blue"*) BG="#00004d" ;;
        "Custom"*) 
            echo -e "\nMasukkan nama warna atau kode HEX (Contoh: #1a1a1a)"
            read -p "Warna: " custom_bg
            [ -n "$custom_bg" ] && BG="$custom_bg"
            ;;
    esac
}

# --- PROSES UTAMA (CONVERT) ---
run_process() {
    if [ -z "$INPUT" ]; then
        echo -e "\n\e[31m[!] Error: Silahkan pilih file video/gif terlebih dahulu.\e[0m"
        sleep 2
        return
    fi

    name=$(basename "${INPUT%.*}")
    OUT="/sdcard/boot/$name"
    WORK="$TMP/$name"

    # Reset folder kerja
    rm -rf "$WORK"
    mkdir -p "$WORK/project/part0"
    mkdir -p "$OUT"

    print_status
    echo -e "\e[1;34m[1/3]\e[0m Memulai ekstraksi frame dengan FFmpeg (Ukuran Asli)..."
    # Ekstrak tanpa mengubah ukuran sama sekali
    ffmpeg -loglevel error -stats -i "$INPUT" \
        -vf "fps=$FPS,format=rgba" \
        "$WORK/project/%04d.png"

    echo -e "\e[1;34m[2/3]\e[0m Menyesuaikan ukuran (Kecilkan jika besar) & Background..."
    cd "$WORK/project" || exit
    
    # PENJELASAN LOGIKA IMAGEMAGICK:
    # -resize "${WIDTH}x${HEIGHT}>" : Tanda '>' artinya HANYA kecilkan jika gambar lebih besar dari target.
    # -background "$BG" -gravity center -extent : Buat kanvas dan taruh gambar di tengah.
    magick *.png -resize "${WIDTH}x${HEIGHT}>" \
           -background "$BG" -gravity center \
           -extent ${WIDTH}x${HEIGHT} part0/%04d.png

    echo -e "\e[1;34m[3/3]\e[0m Membuat desc.txt & memaketkan ZIP..."
    # Membuat file konfigurasi bootanimation
    cat > desc.txt << EOF
$WIDTH $HEIGHT $FPS
p 0 0 part0 #000000 -1
EOF

    # Kompresi dengan level 0 (Store) sesuai standar Android
    zip -q -r -0 "$OUT/bootanimation.zip" desc.txt part0
    
    cd "$HOME"
    rm -rf "$WORK"
    
    echo -e "\n\e[1;32m✅ PROSES BERHASIL!\e[0m"
    echo -e "Hasil: $OUT/bootanimation.zip"
    echo -e "\nTekan Enter untuk kembali ke Menu Utama..."
    read
}


# --- MENU UTAMA ---
main_menu() {
    while true; do
        print_status
        options=(
            "1. 📂 Browse File"
            "2. 📺 Set Resolution"
            "3. ⚡ Set FPS"
            "4. 🎨 Set Background"
            "5. 🚀 START CONVERT"
            "6. ❌ Exit"
        )

        choice=$(printf "%s\n" "${options[@]}" | fzf --height 12 --reverse --border --prompt="Menu Utama > ")

        case "$choice" in
            "1."*) choose_file ;;
            "2."*) set_resolution ;;
            "3."*) set_fps ;;
            "4."*) set_background ;;
            "5."*) run_process ;;
            "6."*) exit ;;
            *) [ -z "$choice" ] && exit ;; # Keluar jika tekan ESC
        esac
    done
}

# Jalankan skrip
main_menu
